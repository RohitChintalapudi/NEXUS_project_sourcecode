<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nexus.controller.MainController"
           styleClass="root" prefWidth="1380.0" prefHeight="880.0">

    <!-- Primary Base Layout -->
    <BorderPane fx:id="mainBorderPane">

        <!-- Top Global Application Bar -->
        <top>
            <HBox styleClass="app-header" spacing="14" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="NEXUS" style="-fx-font-size: 13px; -fx-font-weight: 900; -fx-text-fill: -color-accent-gold;" />
                    <Label text="DEVELOPER WORKSPACE" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: -color-text-muted;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Current Workspace Breadcrumb & Window Actions -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-background-color: -color-bg-card; -fx-padding: 4px 10px; -fx-border-color: -color-border-subtle; -fx-border-radius: 6px; -fx-background-radius: 6px;">
                        <Label text="WORKSPACE:" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: -color-text-muted;" />
                        <Label text="NEXUS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: -color-accent-gold; -fx-font-family: 'JetBrains Mono', Consolas, monospace;" />
                        <Label text="•" style="-fx-text-fill: -color-text-muted;" />
                        <Label text="main" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: -color-accent-purple; -fx-font-family: 'JetBrains Mono', Consolas, monospace;" />
                    </HBox>

                    <!-- Fullscreen / Maximize Toggle -->
                    <Button fx:id="btnToggleFullscreen" text="Fullscreen" styleClass="btn-secondary" onAction="#handleToggleFullscreen" />

                    <!-- Nexus AI Toggle Pill -->
                    <Button fx:id="btnToggleAi" text="Nexus AI" styleClass="btn-primary" onAction="#handleToggleAiPanel" />
                </HBox>
            </HBox>
        </top>

        <!-- Center: Sidebar on Left, Central Workspace in Middle, Persistent AI Panel on Right -->
        <center>
            <HBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

                <!-- Left Sidebar -->
                <StackPane fx:id="sidebarContainer" />

                <!-- Central Workspace (Dynamic Switcher) -->
                <StackPane fx:id="centralWorkspaceContainer" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="workspace-area" />

                <!-- Persistent Right AI Assistant Panel -->
                <StackPane fx:id="aiPanelContainer" />

            </HBox>
        </center>

        <!-- Bottom: Persistent Analytics Bar -->
        <bottom>
            <StackPane fx:id="bottomBarContainer" />
        </bottom>

    </BorderPane>

    <!-- Overlay Layer for Settings Flyout / Modal -->
    <StackPane fx:id="modalOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.65);" />

</StackPane>

