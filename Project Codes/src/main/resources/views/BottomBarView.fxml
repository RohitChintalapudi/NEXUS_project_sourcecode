<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nexus.controller.BottomBarController"
      styleClass="bottom-analytics-bar" spacing="14" alignment="CENTER_LEFT">

    <!-- Actual real-time hardware telemetry indicator -->
    <HBox alignment="CENTER_LEFT" spacing="6">
        <Label fx:id="lblTelemetryStatus" text="● LIVE TELEMETRY"
               style="-fx-background-color: rgba(16,185,129,0.15); -fx-text-fill: #10b981; -fx-border-color: rgba(16,185,129,0.4); -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 2px 7px; -fx-font-size: 9px; -fx-font-weight: bold; -fx-letter-spacing: 0.5px;" />
    </HBox>

    <Region styleClass="bottom-divider" />

    <!-- CPU Gauge Container -->
    <HBox fx:id="cpuGaugeContainer" alignment="CENTER_LEFT" />

    <Region styleClass="bottom-divider" />

    <!-- RAM Gauge Container -->
    <HBox fx:id="ramGaugeContainer" alignment="CENTER_LEFT" />

    <Region styleClass="bottom-divider" />

    <!-- Disk Gauge Container -->
    <HBox fx:id="diskGaugeContainer" alignment="CENTER_LEFT" />

    <Region styleClass="bottom-divider" />

    <!-- Network Activity -->
    <HBox alignment="CENTER_LEFT" spacing="6">
        <Label text="NET:" styleClass="telemetry-title" />
        <Label fx:id="lblNetworkTraffic" text="▲ 0 KB/s  ▼ 0 KB/s" styleClass="telemetry-value" />
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <!-- System Uptime -->
    <HBox alignment="CENTER_LEFT" spacing="6">
        <Label text="UPTIME:" styleClass="telemetry-title" />
        <Label fx:id="lblSystemUptime" text="00h 00m 00s" styleClass="telemetry-value" style="-fx-text-fill: -color-accent-gold;" />
    </HBox>

    <Region styleClass="bottom-divider" />

    <!-- Active Shell & Branch -->
    <HBox alignment="CENTER_LEFT" spacing="6">
        <Label fx:id="lblActiveShellIndicator" text="SHELL: PowerShell" styleClass="telemetry-title" style="-fx-text-fill: -color-accent-amber;" />
        <Label text="•" style="-fx-text-fill: -color-text-muted;" />
        <Label text="main" styleClass="telemetry-value" style="-fx-text-fill: -color-accent-purple;" />
    </HBox>

</HBox>
